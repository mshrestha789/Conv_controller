[Unit]
Description=Stem Conveyor Imaging Station
After=graphical-session.target

[Service]
Type=notify
WorkingDirectory=/home/conveyer/Conv_controller
ExecStart=/usr/bin/python3 /home/conveyer/Conv_controller/main.py

# The GUI sends WATCHDOG=1 from its main Qt event loop every ~1 second.
# If the event loop freezes for 5 seconds, systemd treats the service as failed.
WatchdogSec=5s
Restart=on-failure
RestartSec=1s

# Keep camera_worker.py in the same service cgroup so systemd also kills
# child camera workers when stopping/restarting the application.
KillMode=control-group
TimeoutStopSec=3s

# Optional extra software layer for the ACTIVE-LOW forward relay.
# On Raspberry Pi OS, pinctrl can force GPIO27 HIGH (= relay OFF).
# Test these commands manually first on your Pi. If your user cannot run
# pinctrl, comment these two lines until permissions are corrected.
ExecStartPre=/usr/bin/pinctrl 27 op dh
ExecStopPost=/usr/bin/pinctrl 27 op dh

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
