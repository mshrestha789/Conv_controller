[Unit]
Description=Stem Conveyor Imaging Station
After=graphical-session.target

[Service]
Type=notify
WorkingDirectory=/home/conveyer/Conv_controller
ExecStart=/usr/bin/python3 /home/conveyer/Conv_controller/main.py

# Main Qt event loop heartbeat. A frozen GUI becomes a service failure.
WatchdogSec=5s

# Crash/watchdog failures restart automatically. A developer's clean exit to
# Raspberry Pi OS exits with status 0 and therefore stays stopped until the
# next desktop login/boot autostarts it again.
Restart=on-failure
RestartSec=1s

KillMode=control-group
TimeoutStopSec=3s

# ACTIVE-LOW forward/reverse outputs: HIGH = relay OFF.
ExecStartPre=/usr/bin/pinctrl 22 op dh
ExecStartPre=/usr/bin/pinctrl 27 op dh
ExecStopPost=/usr/bin/pinctrl 22 op dh
ExecStopPost=/usr/bin/pinctrl 27 op dh

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
